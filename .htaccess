# BEGIN cPanel-generated php ini directives
<IfModule php8_module>
   php_value error_log "/home/nirmala/logs/php.error.log"
   php_flag log_errors On
</IfModule>

<IfModule lsapi_module>
   php_value error_log "/home/nirmala/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives


<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan rewrite URL yang sudah masuk ke folder public
    RewriteRule ^public/ - [L]

    # Semua request diarahkan ke Laravel public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>